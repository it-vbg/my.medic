{
  "name": "my-medic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:postgres": "playwright test --config playwright.postgres.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "lucide-react": "1.81.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mailparser": "^3.15.0",
    "smtp-server": "^3.21.7",
    "typescript": "~5.9.3"
  }
}
