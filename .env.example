# Copy to .env.local. Use a dedicated database and role.
DATABASE_URL=postgresql://medic_app:replace_me@127.0.0.1:5432/medic
APP_URL=http://127.0.0.1:3000

# For local development, point to a local SMTP inbox (for example Mailpit).
# On a VDS, use your mail provider and a verified sender. Encode special
# characters in URL usernames and passwords (e.g. @ becomes %40).
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM="my.medic <cabinet@example.test>"

# Enable only when the proxy controls X-Real-IP and is the only way to reach Next.js.
# MY_MEDIC_TRUST_PROXY=1

# Opt in to the earlier, separate SQLite cabinet if needed.
# MY_MEDIC_STORAGE=sqlite
# MY_MEDIC_DATA_DIR=
