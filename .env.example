# Leave both unset to use the local Node.js 24 + SQLite cabinet.
# Set both after applying the Supabase migration to use cloud storage.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional absolute path for the local database; defaults to .my-medic/.
# MY_MEDIC_DATA_DIR=
